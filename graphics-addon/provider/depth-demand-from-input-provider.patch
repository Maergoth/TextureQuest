+static std::mutex s_demand_mutex;
+static std::unordered_map<void *, int> s_depth_modules;
+static std::unordered_map<effect_runtime *, tq_depth_runtime> s_depth_runtimes;
+static bool tq_depth_caller(void *module, const void *caller)
+{
+ HMODULE owner = nullptr;
+ return module && GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+  reinterpret_cast<LPCWSTR>(caller), &owner) && owner == module;
+}
+void tq_depth_addon_registered(void *module)
+{
+ const std::lock_guard<std::mutex> lock(s_demand_mutex);
+ s_depth_modules.emplace(module, -1);
+}
+void tq_depth_addon_unregistered(void *module)
+{
+ const std::lock_guard<std::mutex> lock(s_demand_mutex);
+ s_depth_modules.erase(module);
+ for (auto &[runtime, entry] : s_depth_runtimes) entry.manual.erase(module);
+}
+extern "C" __declspec(dllexport) uint32_t WINAPI TextureQuestRegisterDepthParticipantV1(void *module, uint32_t mode)
+{
+ if (mode > 1 || !tq_depth_caller(module, _ReturnAddress())) return 0;
+ const std::lock_guard<std::mutex> lock(s_demand_mutex);
+ const auto it = s_depth_modules.find(module);
+ if (it == s_depth_modules.end()) return 0;
+ it->second = static_cast<int>(mode);
+ return 1;
+}
+extern "C" __declspec(dllexport) uint32_t WINAPI TextureQuestUnregisterDepthParticipantV1(void *module)
+{
+ if (!tq_depth_caller(module, _ReturnAddress())) return 0;
+ const std::lock_guard<std::mutex> lock(s_demand_mutex);
+ const auto it = s_depth_modules.find(module);
+ if (it == s_depth_modules.end()) return 0;
+ it->second = -1; // Remains conservative until normal ReShade unregister.
+ for (auto &[runtime, entry] : s_depth_runtimes) entry.manual.erase(module);
+ return 1;
+}
+extern "C" __declspec(dllexport) uint32_t WINAPI TextureQuestSetManualDepthDemandV1(void *module, void *runtime, uint32_t required)
+{
+ if (required > 1 || !tq_depth_caller(module, _ReturnAddress())) return 0;
+ const std::lock_guard<std::mutex> lock(s_demand_mutex);
+ const auto owner = s_depth_modules.find(module);
+ const auto it = s_depth_runtimes.find(static_cast<effect_runtime *>(runtime));
+ if (owner == s_depth_modules.end() || owner->second != 1 || it == s_depth_runtimes.end()) return 0;
+ it->second.manual[module] = required != 0;
+ return 1;
+}
+extern "C" __declspec(dllexport) uint32_t WINAPI TextureQuestGetDepthStatusV1(void *module, void *runtime, tq_depth_v1::Status *status, uint32_t bytes)
+{
+ if (bytes != sizeof(tq_depth_v1::Status) || !status || status->Size != sizeof(*status) || status->Version != 1 || !tq_depth_caller(module, _ReturnAddress())) return 0;
+ const std::lock_guard<std::mutex> lock(s_demand_mutex);
+ const auto owner = s_depth_modules.find(module);
+ const auto it = s_depth_runtimes.find(static_cast<effect_runtime *>(runtime));
+ if (owner == s_depth_modules.end() || owner->second < 0 || it == s_depth_runtimes.end()) return 0;
+ const auto &gate = it->second.device->gate;
+ tq_depth_v1::Status result;
+ result.DeviceEpoch = gate.epoch.load(std::memory_order_acquire);
+ result.RuntimeReadyEpoch = it->second.data->ready_epoch.load(std::memory_order_acquire);
+ result.Reasons = gate.reasons.load(std::memory_order_acquire);
+ if (gate.Active()) result.Flags |= tq_depth_v1::Tracking;
+ if (gate.Ready(result.RuntimeReadyEpoch)) result.Flags |= tq_depth_v1::Ready;
+ else if (gate.Active()) result.Flags |= tq_depth_v1::Warming;
+ *status = result;
+ return 1;
+}
+static uint32_t tq_depth_reasons(generic_depth_device_data *device)
+{
+ const std::lock_guard<std::mutex> lock(s_demand_mutex);
+ uint32_t result = 0;
+ for (const auto &[module, mode] : s_depth_modules) if (mode < 0) result |= tq_depth_v1::UnknownParticipant;
+ for (const auto &[runtime, entry] : s_depth_runtimes) if (entry.device == device) {
+  result |= entry.technique_reasons;
+  for (const auto &[module, required] : entry.manual) if (required) result |= tq_depth_v1::ManualDemand;
+ }
+ return result;
+}
