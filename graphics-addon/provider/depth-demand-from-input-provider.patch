+static void tq_depth_invalidate(effect_runtime *runtime)
+{
+ auto &data = *runtime->get_private_data<generic_depth_data>();
+ auto *device_data = runtime->get_device()->get_private_data<generic_depth_device_data>();
+ if (data.active_pairs != 0) return;
+ const uint64_t epoch = device_data->gate.epoch.load(std::memory_order_acquire);
+ if (data.binding_epoch == epoch) return; // Invalidate once per epoch, including idle.
+ data.ready_epoch.store(0, std::memory_order_release);
+ if (data.selected_shader_resource != 0) {
+  runtime->get_device()->destroy_resource_view(data.selected_shader_resource);
+  device_data->untrack_depth_stencil(runtime->get_device(), data.selected_depth_stencil);
+ }
+ data.selected_depth_stencil = { 0 }; data.selected_shader_resource = { 0 }; data.using_backup_texture = false;
+ data.binding_epoch = epoch;
+ update_effect_runtime(runtime);
+}
