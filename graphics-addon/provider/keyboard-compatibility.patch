 static concurrency::concurrent_unordered_map<UINT64, std::pair<HHOOK, HOOKPROC>> s_windows_hooks;
 
+// Classify only actual Alt-class input. Non-Alt callbacks retain upstream
+// chaining so keys such as Home still reach ReShade's normal input path.
+template <DWORD hook_id>
+static bool tq_keyboard_alt_class(LPARAM lParam)
+{
+    if constexpr (hook_id == WH_KEYBOARD)
+        return (static_cast<UINT64>(lParam) & (UINT64(1) << 29)) != 0;
+    else if constexpr (hook_id == WH_KEYBOARD_LL)
+        return lParam != 0 && (reinterpret_cast<const KBDLLHOOKSTRUCT *>(lParam)->flags & LLKHF_ALTDOWN) != 0;
+    else
+        return false;
+}
+
+// Private compatibility evidence only. No key codes, text, scan codes, handles,
+// addresses or thread IDs are logged. One shared cap lasts for this DLL load.
+#if defined(TQ_PRIVATE_INPUT_COMPAT_TRACE) && TQ_PRIVATE_INPUT_COMPAT_TRACE
+static std::atomic<unsigned int> s_tq_private_input_events = 0;
+static void tq_private_input_event(const char *event, DWORD hook_id, bool global, bool alt_honored)
+{
+	if (hook_id != WH_KEYBOARD && hook_id != WH_KEYBOARD_LL)
+		return;
+	unsigned int count = s_tq_private_input_events.load(std::memory_order_relaxed);
+	while (count < 16)
+	{
+		if (s_tq_private_input_events.compare_exchange_strong(count, count + 1, std::memory_order_relaxed))
+		{
+			reshade::log::message(reshade::log::level::info,
+				"TQ_INPUT_COMPAT v2 event=%s hook=%s scope=%s alt_class=%s original_nonzero_honored=%s limit=16",
+				event, hook_id == WH_KEYBOARD ? "keyboard" : "keyboard_ll", global ? "global" : "thread",
+				alt_honored ? "1" : "not_applicable", alt_honored ? "1" : "not_applicable");
+			return;
+		}
+	}
+}
+template <DWORD hook_id>
+static void tq_private_input_honored(LPARAM lParam, bool global)
+{
+	if (s_tq_private_input_events.load(std::memory_order_relaxed) >= 16)
+		return;
+	if (tq_keyboard_alt_class<hook_id>(lParam))
+		tq_private_input_event("original_nonzero_honored", hook_id, global, true);
+}
+#else
+static void tq_private_input_event(const char *, DWORD, bool, bool) {}
+template <DWORD hook_id>
+static void tq_private_input_honored(LPARAM, bool) {}
+#endif
+
